{
  "execution_form": {
    "config_overrides": {
      "debug": {
        "clear_db_on_run": false
      },
      "limits": {
        "cdx_url_limit": 200,
        "crawler_live_max_pages": 500,
        "crawler_wayback_max_pages": 200,
        "dns_max_domains": 50,
        "file_max_files": 120,
        "file_max_size": 26214400,
        "file_max_workers": 5,
        "js_max_scripts": 50,
        "nmap_batch_size": 10,
        "robots_max_urls": 20,
        "sitemap_max_urls": 20,
        "subdomain_max": 50,
        "wayback_max_snapshots": 300,
        "wayback_min_year": 2000
      },
      "logging": {
        "mode": "DEBUG",
        "timezone": "Europe/Madrid"
      },
      "modules": {
        "crawling": true,
        "dns": true,
        "email_passive": true,
        "file_parsing": true,
        "http_headers": true,
        "js_parsing": true,
        "nmap": true,
        "scraping": true,
        "shodan": true,
        "subdomains": true,
        "wayback": true,
        "whois": true
      },
      "retries": {
        "crtsh_max_attempts": 50
      },
      "timeouts": {
        "crawler_live_page": 3,
        "crawler_wayback_page": 8,
        "dns_resolution": 15,
        "file_download": 2,
        "http_headers": 15,
        "http_passive_email": 20,
        "http_robots": 5,
        "http_sitemap": 8,
        "http_subdomains": 75,
        "js_connect": 3,
        "js_read": 5,
        "nmap_scan": 120,
        "scraping_page_load": 15000,
        "wayback_cdx_api": 25
      },
      "tools": {
        "nmap_path": "C:\\\\Program Files (x86)\\\\Nmap\\\\nmap.exe"
      }
    },
    "target": "urjc.es"
  }
}